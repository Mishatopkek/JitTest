@page "/sizes"
@implements IDisposable
@inject BacklogRepository Repo
@inject UiState Ui

<PageTitle>Sizes</PageTitle>

<MudText Typo="Typo.h6" Class="mb-1">Short, medium, long</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Equal thirds of what you can actually start, not fixed hour cutoffs — so
    "long" means the longest third of the playable pool, and the boundaries move
    as you finish things. This is the exact pool <code>game_roll()</code> and
    <code>game_random()</code> draw from: if a game is not here, neither can
    offer it. A split purchase appears as its playable part.
</MudText>

@if (!Ui.ShowHours)
{
    <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-4">
        Lengths are hidden, so picking from a bucket stays a surprise. The timer
        icon in the top bar reveals them.
    </MudAlert>
}

@if (_rows is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* The shape of what is left. The three cards below are always a third each
       by construction, so they cannot answer "is my backlog mostly quick hits or
       mostly monsters" -- this can.

       Deliberately NOT behind UiState.ShowHours. The chart names no game, so
       nothing here tells you how long any particular title is; it describes the
       collection, which is the same thing the bucket counts below already do. *@
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle2">Games you can start, by length</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
            One dot per game — all @_bandTotal of them, lined up shortest to
            longest. Half sit under @_medianLabel.
        </MudText>

        @* One dot per unit, no bands anywhere: x is the game's position in the
           sorted pool and y is its own recorded length. Every value is its own
           mark, which is as much resolution as 193 games have.

           One series, so no legend -- the heading names it, and a second colour
           would encode nothing. No per-point labels: 193 of them is not a chart. *@
        @* Height covers plot AND the x-axis band, so the axis labels are not cut
           off into a nested scrollbar. *@
        <MudChart T="double"
                  ChartType="ChartType.ScatterPlot"
                  ChartSeries="_dotSeries"
                  ChartOptions="_dotOptions"
                  Width="100%" Height="320px" />

        <MudText Typo="Typo.caption" Align="Align.Center"
                 Class="mud-text-secondary d-block">
            games, sorted shortest to longest
        </MudText>

        @* The chart's table twin: every value on it is readable without hover. *@
        <MudExpansionPanels Elevation="0" Class="mt-2">
            <MudExpansionPanel Text="Show as a table" Dense="true">
                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>Length (hours)</th>
                            <th style="text-align:right">Games</th>
                            <th style="text-align:right">Hours in band</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var band in _bands)
                        {
                            <tr>
                                <td>@band.Label</td>
                                <td style="text-align:right">@band.Units</td>
                                <td style="text-align:right">@band.BandHours.ToString("0.#")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudPaper>

    <MudGrid Class="mb-4">
        @foreach (var g in _rows.GroupBy(r => new { r.Tier, r.TierName }).OrderBy(g => g.Key.Tier))
        {
            <MudItem xs="12" sm="4">
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.overline">@g.Key.TierName</MudText>
                    <MudText Typo="Typo.h5">@g.Count()</MudText>
                    @if (Ui.ShowHours)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @g.Min(r => r.Hours)?.ToString("0.#")–@g.Max(r => r.Hours)?.ToString("0.#")h
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @g.Sum(r => r.Hours ?? 0).ToString("0")h total
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">games</MudText>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    @* Sorted by name, not by length: ordering by hours would rank the bucket
       shortest-first and give the lengths away without printing them. *@
    <MudDataGrid T="TierRow" Items="Ordered" Groupable="true" Dense="true" Hover="true"
                 Filterable="true" FilterMode="DataGridFilterMode.ColumnFilterRow"
                 SortMode="SortMode.Multiple" Elevation="0" Outlined="true">
        <Columns>
            <PropertyColumn Property="x => x.TierName" Title="Size" Grouping="true" Hidden="true">
                <GroupTemplate>
                    <MudText Typo="Typo.subtitle2">
                        @context.Grouping.Key (@context.Grouping.Count())
                    </MudText>
                </GroupTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.UnitName" Title="Game" />

            <TemplateColumn Title="Inside" Sortable="false">
                <CellTemplate>
                    @if (context.Item.IsPart)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                            @context.Item.OwnedAs
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>

            @* Hidden rather than omitted, so revealing it keeps its place
               instead of appending after Rank. *@
            <PropertyColumn Property="x => x.Hours" Title="Hours" Format="0.#"
                            Hidden="@(!Ui.ShowHours)" />

            <PropertyColumn Property="x => x.Priority" Title="Rank" />
        </Columns>
    </MudDataGrid>
}

@code {
    private List<TierRow>? _rows;

    private List<LengthBand> _bands = [];
    private List<ChartSeries<double>> _dotSeries = [];
    private int _bandTotal;
    private string _medianLabel = "";

    /// <summary>
    /// Every dot is the theme primary. One series, so there is no identity to
    /// encode with a second colour, and shading a dot by its own height would
    /// spend the colour channel on what the height already says.
    ///
    /// The colour is a CSS variable rather than a literal so the chart follows
    /// MainLayout.Theme and dark mode without this page knowing either.
    /// </summary>
    private readonly ScatterPlotChartOptions _dotOptions = new()
    {
        ChartPalette = ["var(--mud-palette-primary)"],
        // Horizontal rules only; verticals across a rank axis mean nothing.
        XAxisLines = false,
        YAxisLines = true,
        YAxisTitle = "hours",
        // No XAxisTitle: MudBlazor renders it above the plot, where it reads as a
        // second heading contradicting the real one. The x label goes underneath
        // the chart as a caption instead.
        ShowLegend = false,
        ShowToolTips = true,
        // 193 numbers printed on 193 dots is not a chart.
        ShowDataLabels = false,
        // Small enough that a cluster still reads as separate games rather than a
        // solid block.
        PointRadius = 3,

        // A length axis starts at zero; a cropped baseline would exaggerate how
        // steeply the collection climbs.
        YAxisRequireZeroPoint = true,
        // Without a cap MudBlazor draws a rule every 20h -- forty gridlines for a
        // 718h range, which buries the dots in chrome.
        MaxNumYAxisTicks = 8

        // A log y-axis was tried here and does not work: MudBlazor picks "nice"
        // tick values in whatever space the data is in, so feeding it log10(hours)
        // produced a tick at ~19 and a label of 10^19 hours. There is no log scale
        // and no hook to place ticks, so the axis stays linear -- which means the
        // single 718h game flattens the rest. That 718 is not a real length: it is
        // (52.5 + 101.5 + 2000) / 3, and only one game in the collection has a
        // completionist figure over 500. hours_main tops out at 109.
    };

    // Hiding the Hours column is not enough on its own -- a list ordered by
    // length still reads as a ranking of length. Sort by name unless revealed.
    private IEnumerable<TierRow> Ordered => Ui.ShowHours
        ? _rows!.OrderBy(r => r.Tier).ThenBy(r => r.Hours)
        : _rows!.OrderBy(r => r.Tier).ThenBy(r => r.UnitName);

    protected override async Task OnInitializedAsync()
    {
        Ui.Changed += Redraw;
        _rows = await Repo.GetTiersAsync();

        // One (x, y) per unit: x is its place in the sorted pool, y its own hours.
        // No aggregation at all -- this is every recorded value, which is the most
        // resolution 193 games can carry.
        var points = _rows
            .Where(r => r.Hours > 0)
            .OrderBy(r => r.Hours!.Value)
            .Select((r, i) => ((double)(i + 1), (double)r.Hours!.Value))
            .ToList();

        _dotSeries = [new ChartSeries<double>
        {
            Name = "Games",
            Data = new ChartData<double>(points)
        }];

        // The bands still back the table view: a 193-row table is not readable,
        // and the point of a table twin is that values ARE readable.
        _bands = await Repo.GetLengthBandsAsync();
        _bandTotal = _bands.Sum(b => b.Units);
        _medianLabel = MedianLabel();
    }

    /// <summary>
    /// Which band the middle game falls in, walked over the band counts rather
    /// than over hours -- the caption is about the chart's own buckets, and this
    /// way it cannot drift from whatever bands the view defines.
    /// </summary>
    private string MedianLabel()
    {
        if (_bandTotal == 0) return "—";

        var half = _bandTotal / 2;
        var seen = 0;
        foreach (var band in _bands)
        {
            seen += band.Units;
            if (seen >= half) return $"{band.Label}h";
        }

        return _bands[^1].Label + "h";
    }

    public void Dispose() => Ui.Changed -= Redraw;

    private void Redraw() => InvokeAsync(StateHasChanged);
}
