<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Backlog.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

@* Enhanced navigation is off app-wide. It patches the DOM client-side from a
   fetched response, on its own schedule rather than the circuit's, and under
   real latency the two can reach the same nodes -- the suspected source of the
   "Cannot read properties of null (reading 'insertBefore'/'removeChild')"
   exceptions killing circuits on the Pi. Nothing is given up by turning it off:
   every page here is InteractiveServer, so the router already routes over the
   circuit.

   The attribute must sit on an ELEMENT. Putting it on <Routes> compiles and
   then throws at parameter binding -- "Object of type 'Routes' does not have a
   property matching the name 'data-enhance-nav'" -- 500ing every request. *@
<body data-enhance-nav="false">
    @* Interactivity is set here, for the whole app including the layout. With
       per-page @@rendermode the app bar renders statically and its buttons have
       no handlers -- the theme toggle silently does nothing. *@
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script>
        // Turns off the pre-hydration fallback in app.css once the real theme
        // is known. See the comment at the top of that file.
        window.setTheme = t => document.documentElement.setAttribute('data-theme', t);
    </script>
</body>

</html>
