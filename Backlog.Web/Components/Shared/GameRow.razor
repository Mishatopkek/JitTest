@inject BacklogRepository Repo
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject UiState Ui
@implements IDisposable

<MudPaper Outlined="true" Class="pa-2">
    <div class="d-flex align-center gap-2">

        @if (Position is null && OnRank.HasDelegate && !Game.Finished)
        {
            <MudIconButton Icon="@Icons.Material.Rounded.Add" Size="Size.Small"
                           title="Add to ranked" OnClick="OnRank" />
        }
        else if (Position is not null)
        {
            <MudIcon Icon="@Icons.Material.Rounded.DragIndicator" Size="Size.Small"
                     Class="@(Draggable ? "mud-text-secondary" : "mud-text-disabled")" />
            @if (_moving)
            {
                @* Same width as the number it replaces, so the row doesn't shift *@
                <div style="flex:0 0 2.25rem;width:2.25rem">
                    <MudNumericField T="int?" @bind-Value="_moveTo" Min="1" HideSpinButtons="true"
                                     Immediate="true" Margin="Margin.None" Variant="Variant.Text"
                                     Typo="Typo.body2" Placeholder="@Position.ToString()"
                                     OnKeyDown="OnMoveKey" OnBlur="CancelMove" AutoFocus="true"
                                     title="Type a position, Enter to move, Esc to cancel" />
                </div>
            }
            else if (OnMove.HasDelegate)
            {
                <MudLink Typo="Typo.body2" Color="Color.Primary" Underline="Underline.None"
                         OnClick="@(() => _moving = true)" title="Move to a position"
                         Style="min-width:2.25rem;font-variant-numeric:tabular-nums;font-weight:600;cursor:pointer">
                    @Position
                </MudLink>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Primary"
                         Style="min-width:2.25rem;font-variant-numeric:tabular-nums;font-weight:600">
                    @Position
                </MudText>
            }
        }

        @* Whole-game toggle. On a split game this sets EVERY part, because the
           parent's finished state is the roll-up of its parts. *@
        <MudCheckBox T="bool" Value="Game.Finished" ValueChanged="SetFinishedAsync"
                     Color="Color.Primary" Dense="true"
                     title="@(Game.IsSplit
                              ? (Game.Finished ? "Mark every part unplayed" : "Mark every part finished")
                              : (Game.Finished ? "Mark unplayed" : "Mark finished"))" />

        @if (Game.IsSplit)
        {
            <MudLink Typo="Typo.body1" Underline="Underline.None" Color="Color.Inherit"
                     OnClick="@(() => _open = !_open)" Style="cursor:pointer"
                     Class="@NameClass">
                @Game.Name
                <MudIcon Icon="@(_open ? Icons.Material.Rounded.ExpandLess : Icons.Material.Rounded.ExpandMore)"
                         Size="Size.Small" Class="ml-1" />
            </MudLink>
        }
        else
        {
            <MudText Typo="Typo.body1" Class="@NameClass">@Game.Name</MudText>
        }

        <MudSpacer />

        @if (Game.BlockedBy is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                     title="An earlier game in this series is still unfinished.">
                after @Game.BlockedBy
            </MudChip>
        }

        @if (Game.Series is not null)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                @Game.Series @Game.SeriesPosition@(Game.SeriesTotal is null ? "" : $"/{Game.SeriesTotal}")
            </MudChip>
        }

        @if (Game.IsSplit)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     title="@(Game.NextUp is null ? "All parts finished" : $"Next: {Game.NextUp}")">
                @Game.PartsFinished/@Game.Parts played
            </MudChip>
        }

        @foreach (var tag in Game.Tags)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                     OnClose="@(() => RemoveTagAsync(tag))">@tag</MudChip>
        }

        @if (_tagging)
        {
            <MudAutocomplete T="string" @bind-Value="_newTag" SearchFunc="SearchTags"
                             CoerceValue="true" Immediate="true" Dense="true"
                             Margin="Margin.Dense" Variant="Variant.Outlined"
                             Placeholder="tag" Style="max-width:11rem"
                             OnKeyDown="OnTagKey" AutoFocus="true" />
            <MudIconButton Icon="@Icons.Material.Rounded.Check" Size="Size.Small"
                           OnClick="AddTagAsync" title="Add tag" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Rounded.Sell" Size="Size.Small"
                           title="Add a tag" OnClick="@(() => _tagging = true)" />
        }

        <MudIconButton Icon="@Icons.Material.Rounded.CallSplit" Size="Size.Small"
                       title="@(Game.IsSplit
                                ? "Edit the games inside this purchase"
                                : "Split this purchase into the games inside it")"
                       OnClick="OpenSplitAsync" />

        @if (Position is not null)
        {
            <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small"
                           title="Unrank" OnClick="OnUnrank" />
        }
    </div>

    @* A note is always shown when there is one. It carries things the row
       cannot -- a translation patch that is not out yet -- and a tooltip would
       hide exactly the rows you need warning about. *@
    @if (!string.IsNullOrWhiteSpace(Game.Notes))
    {
        <div class="d-flex align-start gap-2 mt-1 ml-8">
            <MudIcon Icon="@Icons.Material.Rounded.StickyNote2" Size="Size.Small"
                     Class="mud-text-secondary" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Game.Notes</MudText>
        </div>
    }

    @if (Game.IsSplit)
    {
        <MudCollapse Expanded="_open">
            <div class="d-flex flex-column gap-1 mt-2 ml-8 pl-3"
                 style="border-left:2px solid var(--mud-palette-lines-default)">
                @foreach (var part in Parts)
                {
                    <div class="d-flex align-center gap-2">
                        <MudCheckBox T="bool" Value="part.Finished" Dense="true" Color="Color.Primary"
                                     ValueChanged="@(v => SetPartFinishedAsync(part, v))"
                                     title="@(part.Finished ? "Mark unplayed" : "Mark finished")" />
                        <MudText Typo="Typo.body2" Color="Color.Primary"
                                 Style="min-width:1.5rem;font-variant-numeric:tabular-nums">
                            @part.Position
                        </MudText>
                        <MudText Typo="Typo.body2"
                                 Class="@(part.Finished ? "mud-text-disabled" : "")"
                                 Style="@(part.Finished ? "text-decoration:line-through" : "")">
                            @part.Name
                        </MudText>
                        <MudSpacer />
                        @if (part.BlockedBy is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                                after @part.BlockedBy
                            </MudChip>
                        }
                        @if (Ui.ShowHours && part.Hours is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                @part.Hours.Value.ToString("0")h
                            </MudChip>
                        }
                    </div>
                }
            </div>
        </MudCollapse>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Game Game { get; set; } = null!;
    [Parameter] public int? Position { get; set; }
    [Parameter] public bool Draggable { get; set; } = true;
    [Parameter] public List<string> Tags { get; set; } = [];
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnRank { get; set; }
    [Parameter] public EventCallback OnUnrank { get; set; }

    // Takes the 1-based rank to move to
    [Parameter] public EventCallback<int> OnMove { get; set; }

    /// <summary>
    /// The games inside this purchase, empty when it is not split. Handed down
    /// rather than fetched here: the board holds every row's parts already, and
    /// a query per row was a round trip per split game on every single render.
    ///
    /// They must still ALWAYS be present, not fetched on expand -- the old UI
    /// cached them only for expanded rows, and the split editor opened blank for
    /// a collapsed game, which read as "no parts" and wiped it.
    /// </summary>
    [Parameter] public List<Part> Parts { get; set; } = [];

    private bool _open;
    private bool _tagging;
    private string? _newTag;
    private bool _moving;
    private int? _moveTo;

    // What was on screen at the last render. The board re-renders all ~240 rows
    // on every keystroke in the search box and every tag chip, and diffing a row
    // whose inputs did not move is pure cost. Game is a record and the board
    // hands out fresh instances on reload, so equality here is both cheap and
    // exact: unchanged row, unchanged instance, no re-render.
    private (Game?, int?, bool, List<string>?, List<Part>?, bool, bool, string?, bool, int?) _rendered;

    private string NameClass => Game.Finished ? "mud-text-disabled" : "";

    protected override void OnInitialized() => Ui.Changed += Redraw;

    public void Dispose() => Ui.Changed -= Redraw;

    // ShowHours is read during render but is not a parameter, so a theme-style
    // signature would miss it. Forcing the next render past ShouldRender is
    // simpler than folding it in.
    private void Redraw()
    {
        _rendered = default;
        InvokeAsync(StateHasChanged);
    }

    protected override bool ShouldRender()
    {
        var now = (Game, Position, Draggable, Tags, Parts, _open, _tagging, _newTag, _moving, _moveTo);
        if (_rendered == now) return false;

        _rendered = now;
        return true;
    }

    private async Task SetFinishedAsync(bool finished)
    {
        await Repo.SetGameFinishedAsync(Game.Id, finished);
        Snackbar.Add(finished ? "Finished" : "Reopened", MudBlazor.Severity.Success);
        await OnChanged.InvokeAsync();
    }

    private async Task SetPartFinishedAsync(Part part, bool finished)
    {
        await Repo.SetPartFinishedAsync(part.Id, finished);
        // Finishing one part can unblock something anywhere in the series, so
        // reload the whole board rather than patching this row.
        await OnChanged.InvokeAsync();
    }

    private Task<IEnumerable<string>> SearchTags(string? value, CancellationToken ct)
    {
        var pool = Tags.Where(t => !Game.Tags.Contains(t, StringComparer.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(value))
        {
            pool = pool.Where(t => t.Contains(value, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(pool);
    }

    private async Task OnTagKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTagAsync();
        else if (e.Key == "Escape") { _tagging = false; _newTag = null; }
    }

    private async Task OnMoveKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await MoveAsync();
        else if (e.Key == "Escape") CancelMove();
    }

    private void CancelMove()
    {
        _moving = false;
        _moveTo = null;
    }

    private async Task MoveAsync()
    {
        var to = _moveTo;
        _moving = false;
        _moveTo = null;
        if (to is null || to == Position) return;

        await OnMove.InvokeAsync(to.Value);
    }

    private async Task AddTagAsync()
    {
        var tag = _newTag?.Trim();
        _tagging = false;
        _newTag = null;
        if (string.IsNullOrEmpty(tag)) return;

        await Repo.AddTagAsync(Game.Id, tag);
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveTagAsync(string tag)
    {
        await Repo.RemoveTagAsync(Game.Id, tag);
        await OnChanged.InvokeAsync();
    }

    private async Task OpenSplitAsync()
    {
        var parameters = new DialogParameters<SplitDialog>
        {
            { x => x.GameId, Game.Id },
            { x => x.GameName, Game.Name },
            { x => x.Existing, Parts }
        };

        var dialog = await Dialogs.ShowAsync<SplitDialog>("Split", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _open = true;
            await OnChanged.InvokeAsync();
        }
    }
}
